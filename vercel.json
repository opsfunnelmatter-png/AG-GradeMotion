{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build.js",
  "outputDirectory": ".",
  "routes": [
    { "src": "/thank-you", "dest": "/thank-you.html" },
    { "src": "/pay/usd/trial", "dest": "/pay/usd/trial.html" },
    { "src": "/pay/usd/evaluation", "dest": "/pay/usd/trial.html" },
    { "src": "/pay/usd/topic-surgery", "dest": "/pay/usd/topic-surgery.html" },
    { "src": "/pay/usd/exam-readiness", "dest": "/pay/usd/exam-readiness.html" },
    { "src": "/pay/usd/intensive-bootcamp", "dest": "/pay/usd/bootcamp.html" },
    { "src": "/pay/usd/bootcamp", "dest": "/pay/usd/bootcamp.html" },
    { "src": "/pay/my/trial", "dest": "/pay/my/trial.html" },
    { "src": "/pay/my/evaluation", "dest": "/pay/my/trial.html" },
    { "src": "/pay/my/topic-surgery", "dest": "/pay/my/topic-surgery.html" },
    { "src": "/pay/my/exam-readiness", "dest": "/pay/my/exam-readiness.html" },
    { "src": "/pay/my/intensive-bootcamp", "dest": "/pay/my/bootcamp.html" },
    { "src": "/pay/my/bootcamp", "dest": "/pay/my/bootcamp.html" },
    { "src": "/pay/trial", "dest": "/pay/trial.html" },
    { "src": "/pay/evaluation", "dest": "/pay/trial.html" },
    { "src": "/pay/topic-surgery", "dest": "/pay/topic-surgery.html" },
    { "src": "/pay/exam-readiness", "dest": "/pay/exam-readiness.html" },
    { "src": "/pay/intensive-bootcamp", "dest": "/pay/bootcamp.html" },
    { "src": "/pay/bootcamp", "dest": "/pay/bootcamp.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
